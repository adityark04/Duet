# Copy to .env and fill in. `npm start` and docker compose both read it.

# --- App ---
PORT=3000
# Long random string. Keeps everyone signed in across restarts and servers.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Where accounts are stored. Point at a persistent disk when hosting.
DATA_DIR=./data
# Redirect http -> https. Leave false behind Caddy (it redirects for you).
FORCE_HTTPS=false
# Number of reverse proxies in front of the app (Caddy, Render, Fly = 1).
TRUST_PROXY=1
# Front ends on other sites allowed to use this server, comma-separated.
# For GitHub Pages: https://yourname.github.io   (origin only: no /repo path, no trailing slash)
CORS_ORIGINS=

# --- Account storage ---
# Leave empty to store accounts in DATA_DIR/users.json.
# Set both to keep accounts in Upstash Redis (needed on hosts that wipe the disk, e.g. Render free).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- TURN (voice relay for friends on strict networks) ---
# Option A: your own coturn (docker-compose.yml). Use the same secret in both places.
#   TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
#   TURN_SECRET=<long random string>
# Option B: a hosted TURN provider with fixed credentials.
#   TURN_URLS=turn:global.relay.example:80,turn:global.relay.example:443?transport=tcp,turns:global.relay.example:443
#   TURN_USERNAME=
#   TURN_CREDENTIAL=
TURN_URLS=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
# Lifetime of minted TURN credentials, in seconds (Option A only).
TURN_TTL=43200

# --- docker-compose.yml only ---
# Domain for the app (Caddy gets an HTTPS certificate for it automatically).
APP_DOMAIN=karaoke.example.com
# Domain that points at the same server, used by TURN.
TURN_DOMAIN=turn.example.com
# The server's public IPv4 address.
PUBLIC_IP=203.0.113.10
